# ==============================================================================
# NutriTrack AI - Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# For full-stack servers (Render, Cloud Run, Local Node):
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# For static hosting only (e.g. GitHub Pages without a Node backend):
# Add this as a secret in GitHub Repository Settings -> Secrets and variables -> Actions
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_FOR_STATIC_HOSTING"

# Optional: Remote backend server URL if frontend is on GitHub Pages and backend is hosted elsewhere
# VITE_API_URL="https://your-backend-app.onrender.com"

# ------------------------------------------------------------------------------
# 2. Firebase Client Configuration (Accessible in Frontend via VITE_ prefix)
# ------------------------------------------------------------------------------
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Optional: Custom Firestore Database ID (leave as "(default)" for standard setups)
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# 3. Server & Deployment Environment
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
